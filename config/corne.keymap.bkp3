  #include <behaviors.dtsi>
  #include <dt-bindings/zmk/keys.h>
  #include <dt-bindings/zmk/bt.h>
  #include <dt-bindings/zmk/ext_power.h>

  / {
    keymap {
      compatible = "zmk,keymap";
  layer0 {
          bindings = <
          &lt 3 TAB &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P &kp BACKSPACE &mt LEFT_SHIFT ESCAPE &kp A &kp S &kp D &kp F &kp G &kp H &kp J &kp K &kp L &kp SEMICOLON &kp SINGLE_QUOTE &kp LEFT_CONTROL &kp Z &kp X &kp C &kp V &kp B &kp N &kp M &kp COMMA &kp DOT &kp SLASH &none &kp LEFT_GUI &mo 1 &kp SPACE &kp SPACE &lt 2 ENTER &kp RIGHT_ALT
          >;
        };layer1 {
          bindings = <
          &trans &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp BACKSPACE &trans &none &none &none &none &none &kp C_PREVIOUS &kp C_PLAY_PAUSE &kp UP &kp C_NEXT &kp C_VOLUME_UP &none &trans &none &none &none &none &none &none &kp LEFT &kp DOWN &kp RIGHT &kp C_VOLUME_DOWN &none &trans &trans &trans &trans &mo 4 &trans
          >;
        };layer2 {
          bindings = <
          &trans &none &none &none &none &none &none &none &none &none &none &kp BACKSPACE &trans &kp GRAVE &none &none &none &none &none &none &kp MINUS &none &none &kp BACKSLASH &trans &none &none &none &none &none &none &none &kp EQUAL &kp LEFT_BRACKET &kp RIGHT_BRACKET &none &trans &mo 4 &trans &trans &trans &trans
          >;
        };layer3 {
          bindings = <
          &none &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp KP_PLUS &kp KP_N7 &kp KP_N8 &kp KP_N9 &kp KP_MINUS &trans &none &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp KP_ASTERISK &kp KP_N4 &kp KP_N5 &kp KP_N6 &kp KP_SLASH &kp KP_DOT &none &kp F11 &kp F12 &none &kp PRINTSCREEN &kp DELETE &kp KP_N0 &kp KP_N1 &kp KP_N2 &kp KP_N3 &kp KP_EQUAL &kp KP_COMMA &trans &trans &trans &trans &trans &trans
          >;
        };layer4 {
          bindings = <
          &none &none &none &none &kp LOCKING_NUM &kp CAPSLOCK &none &none &none &none &none &none &none &none &none &none &none &none &none &none &none &none &none &none &none &none &none &none &none &none &none &none &none &none &none &none &none &trans &none &none &trans &none
          >;
        };
    };
  }; 
